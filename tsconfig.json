{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "rootDir": "src/core", "outDir": "src/renderer/js/core/typed",
    "declaration": false, "sourceMap": false, "skipLibCheck": true, "noEmitOnError": true, "newLine": "lf",
    "lib": ["ES2024", "DOM"], "types": []
  },
  "include": ["src/core/**/*.mts"]
}
